ntainer .problem-container p>span {\n        color: white !important;\n    }\n\n    .desmond-ide-container .problem-container p>strong {\n        color: white !important;\n    }\n\n    .desmond-icon {\n        height: 20px;\n        width: 20px;\n    }",""]),t.Z=a},8690:function(e,t,n){"use strict";var r=n(8081),o=n.n(r),i=n(3645),a=n.n(i)()(o());a.push([e.id,".desmond-top-bar {\n    position: absolute;\n    background: #efefef;\n    width: 100%;\n    padding: 6px;\n    text-align: center;\n    font-size: 14px;\n    border-bottom: solid 1px #ddd;\n    top: 0;\n    box-sizing: border-box;\n    height: 35px;\n}\n\n.desmond-top-bar:after {\n    content: 'DoSelect Live Preview';\n    color: #aaa;\n    position: absolute;\n    right: 24px;\n}\n\n.desmond-top-bar>span {\n    cursor: pointer;\n}\n\n.desmond-top-bar>span+span {\n    margin-left: 60px;\n}\n\n.desmond-go-to-ide {\n    color: rebeccapurple;\n}\n\n.desmond-wait-info {\n    margin-top: 50px;\n    font-size: 20px;\n}\n\n.desmond-live-preview-iframe {\n    margin-top: 35px;\n    width: 100%;\n    background-color: white;\n}\n\n.desmond-close {\n    color: #ff0000;\n}",""]),t.Z=a},3645:function(e){"use strict";e.exports=function(e){var t=[];return t.toString=function(){return this.map((function(t){var n="",r=void 0!==t[5];return t[4]&&(n+="@supports (".concat(t[4],") {")),t[2]&&(n+="@media ".concat(t[2]," {")),r&&(n+="@layer".concat(t[5].length>0?" ".concat(t[5]):""," {")),n+=e(t),r&&(n+="}"),t[2]&&(n+="}"),t[4]&&(n+="}"),n})).join("")},t.i=function(e,n,r,o,i){"string"==typeof e&&(e=[[null,e,void 0]]);var a={};if(r)for(var s=0;s<this.length;s++){var l=this[s][0];null!=l&&(a[l]=!0)}for(var c=0;c<e.length;c++){var u=[].concat(e[c]);r&&a[u[0]]||(void 0!==i&&(void 0===u[5]||(u[1]="@layer".concat(u[5].length>0?" ".concat(u[5]):""," {").concat(u[1],"}")),u[5]=i),n&&(u[2]?(u[1]="@media ".concat(u[2]," {").concat(u[1],"}"),u[2]=n):u[2]=n),o&&(u[4]?(u[1]="@supports (".concat(u[4],") {").concat(u[1],"}"),u[4]=o):u[4]="".conc